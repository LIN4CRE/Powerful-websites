# ---------------------------------------------------------------------------
# POWERFUL WEBSITES — Vercel environment variables
# Copy into Vercel (Project → Settings → Environment Variables). Never commit.
# ---------------------------------------------------------------------------

# Optional but recommended. Fine-grained GitHub token with "Contents: Read and
# write" on LIN4CRE/Powerful-websites only. Enables the scheduled scanner to
# persist approved/rejected candidates to the `data/live` branch.
GITHUB_DATA_TOKEN=

# Branch the scanner commits to. It is not the production branch, so directory
# updates never trigger an application rebuild.
DATA_BRANCH=data/live

# Public link to the Vercel project used by the UI ("Schedule history").
VERCEL_PROJECT_DASHBOARD_URL=

# Optional overrides (defaults shown)
DATA_REPO_OWNER=LIN4CRE
DATA_REPO_NAME=Powerful-websites
