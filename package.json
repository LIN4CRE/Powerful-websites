{
  "name": "powerful-websites",
  "version": "1.0.0",
  "private": true,
  "description": "Discover the power of the open web \u2014 a continuously verified directory of websites that work without an account.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/LIN4CRE/Powerful-websites.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "VITE_BASE=/Powerful-websites/ BUILD_OUT_DIR=docs tsc -b && VITE_BASE=/Powerful-websites/ BUILD_OUT_DIR=docs vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --force",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "scan": "tsx scripts/scan.ts",
    "scout": "tsx scripts/scout.ts",
    "verify": "tsx scripts/verify.ts",
    "curate": "tsx scripts/curate.ts",
    "icons": "tsx scripts/fetch-icons.ts",
    "icons:generate": "tsx scripts/generate-icons.ts",
    "validate:data": "tsx scripts/validate-data.ts",
    "check:links": "tsx scripts/check-links.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@vercel/functions": "^3.11.2",
    "@vercel/schedules": "^0.0.3",
    "cheerio": "^1.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.50.1",
    "@tailwindcss/vite": "^4.0.6",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "fast-xml-parser": "^4.5.1",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "playwright": "^1.50.1",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.23.0",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.0.5",
    "workbox-window": "^7.4.1",
    "zod": "^3.24.1"
  }
}
